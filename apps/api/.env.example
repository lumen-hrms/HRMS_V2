# ---------------------------------------------------------------------------
# Local development defaults — match docker-compose.yml. Copy this file to
# .env and adjust for staging/production (real secrets, rotated passwords).
# ---------------------------------------------------------------------------

# Used ONLY by `prisma migrate` / `prisma generate`. Owns all schema objects.
# Never used by the running API process.
DATABASE_URL="postgresql://hrms_superuser:hrms_superuser_pw@localhost:5432/hrms?schema=public"

# Used by the API for all tenant business-data queries (employees, leave, ...).
# This role has no BYPASSRLS — every query is subject to the RLS policies
# created in prisma/migrations/20260101000002_roles_and_rls.
TENANT_DATABASE_URL="postgresql://hrms_app:hrms_app_pw@localhost:5432/hrms?schema=public"

# Used ONLY by the platform-admin module. This role has zero grants on the
# `public` schema and therefore cannot query tenant tables at all.
PLATFORM_DATABASE_URL="postgresql://hrms_platform:hrms_platform_pw@localhost:5432/hrms?schema=platform"

# Firebase Auth is the IAM/session provider — real Firebase everywhere,
# there is no local Auth emulator. FIREBASE_PROJECT_ID must match the
# project the web app's config points at (apps/web/.env).
#   - FIREBASE_SERVICE_ACCOUNT_JSON: the full service-account JSON blob on a
#     single line (Firebase console -> Project settings -> Service accounts
#     -> Generate new private key). REQUIRED — token verification, user
#     creation, custom claims, disable/enable all go through the Admin SDK.
#   - FIREBASE_WEB_API_KEY: Project settings -> General -> Web API Key. Used
#     server-side to send Firebase's hosted password-reset email when an
#     admin triggers a reset for another user. Not a secret (also shipped in
#     the web client), but REQUIRED for that endpoint.
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}'
FIREBASE_WEB_API_KEY="your-firebase-web-api-key"

PORT=3000
NODE_ENV=development

# Tenant resolution: in production, the tenant subdomain is parsed from the
# Host header (acme.hrms-platform.com -> "acme"). For local dev, set this to
# "header" to instead resolve the tenant from an X-Tenant-Subdomain header,
# which is far easier to hit from curl/Postman/localhost.
TENANT_RESOLUTION_MODE="header"

# S3-compatible object storage (MinIO locally) for employee documents.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="hrms_minio"
S3_SECRET_KEY="hrms_minio_pw"
S3_BUCKET="hrms-documents"
S3_FORCE_PATH_STYLE=true
