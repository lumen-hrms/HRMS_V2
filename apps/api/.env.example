# ---------------------------------------------------------------------------
# Copy to .env and fill in. The team shares ONE database (Supabase) — get the
# connection strings + role passwords from the team vault. Local Docker
# Postgres is only used by the e2e suite now (see .env.test).
# ---------------------------------------------------------------------------

# Migrations only (`prisma migrate` / `prisma generate`). Supabase SESSION
# pooler (:5432), Supabase `postgres` role — owns objects, has BYPASSRLS.
# Only the migration owner normally needs this filled in.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<POSTGRES_PW>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require"

# API tenant queries. Supabase TRANSACTION pooler (:6543), role `hrms_app`
# (NOBYPASSRLS — every query subject to the RLS policies in
# prisma/migrations/20260101000002_roles_and_rls). `pgbouncer=true` is
# REQUIRED over the transaction pooler.
TENANT_DATABASE_URL="postgresql://hrms_app.<PROJECT_REF>:<HRMS_APP_PW>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=5"

# Platform-admin module. Same pooler, role `hrms_platform` — zero grants on
# `public`, cannot query tenant tables at all.
PLATFORM_DATABASE_URL="postgresql://hrms_platform.<PROJECT_REF>:<HRMS_PLATFORM_PW>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=5"

# Firebase Auth is the IAM/session provider — real Firebase everywhere,
# there is no local Auth emulator. FIREBASE_PROJECT_ID must match the
# project the web app's config points at (apps/web/.env).
#   - FIREBASE_SERVICE_ACCOUNT_JSON: the full service-account JSON blob on a
#     single line (Firebase console -> Project settings -> Service accounts
#     -> Generate new private key). REQUIRED — token verification, user
#     creation, custom claims, disable/enable all go through the Admin SDK.
#   - FIREBASE_WEB_API_KEY: Project settings -> General -> Web API Key. Used
#     server-side to send Firebase's hosted password-reset email when an
#     admin triggers a reset for another user. Not a secret (also shipped in
#     the web client), but REQUIRED for that endpoint.
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}'
FIREBASE_WEB_API_KEY="your-firebase-web-api-key"

PORT=3000
NODE_ENV=development

# Tenant resolution: in production, the tenant subdomain is parsed from the
# Host header (acme.hrms-platform.com -> "acme"). For local dev, set this to
# "header" to instead resolve the tenant from an X-Tenant-Subdomain header,
# which is far easier to hit from curl/Postman/localhost.
TENANT_RESOLUTION_MODE="header"

# S3-compatible object storage (MinIO locally) for employee documents.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="hrms_minio"
S3_SECRET_KEY="hrms_minio_pw"
S3_BUCKET="hrms-documents"
S3_FORCE_PATH_STYLE=true

# Redis (BullMQ) — leave-request escalation timers and the accrual job.
REDIS_URL="redis://localhost:6379"

# Application-layer field encryption (PAN + bank account — module 03,
# CLAUDE.md security non-negotiable). Base64-encoded 32-byte AES-256 key.
# Generate one with: openssl rand -base64 32
# Only PAN/bank-account writes and reveals need this — the rest of the API
# works fine without it, so it's fine to leave unset until you touch those
# fields. From the team vault in shared/deployed environments.
FIELD_ENCRYPTION_KEY=""
