  hours      Decimal             @db.Decimal(6, 2)
  payoutMode OvertimePayoutMode  @map("payout_mode")
  status     OvertimeClaimStatus @default(PENDING_MANAGER)

  managerApproverId String?   @map("manager_approver_id") @db.Uuid
  managerDecidedAt  DateTime? @map("manager_decided_at")
  hrApproverId      String?   @map("hr_approver_id") @db.Uuid
  hrDecidedAt       DateTime? @map("hr_decided_at")
  rejectionReason   String?   @map("rejection_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([employeeId, month])
  @@index([tenantId])
  @@map("overtime_claims")
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────
// TENANT CONFIGURATION — how each tenant's HR rules work. Company Admin
// owns these (via in-app Settings), NOT the platform operator. Seeded with
// working defaults on tenant creation (see platform-admin.service.ts) so a
// new tenant functions before anyone opens Settings. All RLS-scoped like
// every other public table. See docs/TENANT_CONFIGURATION.md.
// ─────────────────────────────────────────────────────────────────────────

model TenantSettings {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid

  // IANA zone; wall-clock shift times and "today" boundaries resolve against this.
  timezone            String @default("Asia/Kolkata")
  // Days of week that are weekly-offs. 0 = Sunday … 6 = Saturday.
  weeklyOffDays       Int[]  @default([0, 6]) @map("weekly_off_days")
  // Day of month the payroll period locks — the only hard deadline the
  // attendance/regularization auto-resolve flow hangs on.
  payrollCutoffDay    Int    @default(25) @map("payroll_cutoff_day")
  // Leave approval chain depth (1 or 2 for V1).
  leaveApprovalLevels Int    @default(2) @map("leave_approval_levels")
  // Days a leave request may sit undecided at a level before the escalation
  // job flags it (see apps/api/src/leave/leave-escalation.processor.ts).
  leaveEscalationDays Int    @default(3) @map("leave_escalation_days")
  // Whether an employee may submit a request that will be Loss of Pay.
  // Enforced by LeaveService.apply().
  allowLopRequests    Boolean @default(true) @map("allow_lop_requests")
  // Financial-year start month (1-12; India default April). Used by
  // resolveLeaveYear() (apps/api/src/leave/leave-year.util.ts) to shift the
  // balance-year boundary for apply()/getBalances()/teamBalances()/the accrual job.
  fyStartMonth        Int    @default(4) @map("fy_start_month")

  // First-run setup wizard (docs/TENANT_CONFIGURATION.md "Onboarding flow"
  // step 3) — skippable, resumable. `setupWizardStep` is the 0-indexed step
  // to resume at; meaningless once status is DISMISSED/COMPLETED.
  setupWizardStatus TenantSetupWizardStatus @default(PENDING) @map("setup_wizard_status")
  setupWizardStep   Int                     @default(0) @map("setup_wizard_step")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("tenant_settings")
  @@schema("public")
}

model Shift {
  id       String @id @default(uuid()) @db.Uuid
