// HRMS Platform — Prisma schema
//
// Multi-tenancy model: SHARED database, SHARED schema (public), every
// tenant-owned table carries a `tenantId` column and is protected by a
// PostgreSQL Row-Level Security policy keyed off the session variable
// `app.current_tenant_id` (set per-request by TenantGuard/PrismaService).
//
// Platform-operator data (the founder's own SaaS-admin console) lives in a
// physically separate Postgres schema (`platform`) with its own DB role
// that has zero grants on the tenant tables below. See:
//   prisma/migrations/*_rls/migration.sql
//   prisma/migrations/*_platform_role_isolation/migration.sql

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "platform"]
}

// ─────────────────────────────────────────────────────────────────────────
// PLATFORM SCHEMA — owned by the SaaS operator, never joined against
// tenant business tables. The `platform` Postgres role can read/write here
// and here only.
// ─────────────────────────────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL

  @@schema("platform")
}

enum SubscriptionPlan {
  TRIAL
  STARTER
  GROWTH
  ENTERPRISE

  @@schema("platform")
}

enum IsolationTier {
  POOLED
  DEDICATED

  @@schema("platform")
}

enum BreakGlassStatus {
  ACTIVE
  EXPIRED
  REVOKED

  @@schema("platform")
}

// The operator-editable plan catalog (Platform Admin → Plans). `key` matches
// the `SubscriptionPlan` values a tenant can be onboarded onto
// (STARTER/GROWTH/ENTERPRISE — TRIAL is a status, not a sold plan). Seeded
// from platform-admin/entitlements.ts (which stays as the code-side default
// + fallback). Editing a Plan row NEVER mutates a live Subscription — those
// carry a snapshot; new tenants and renewals pick up the current Plan.
model Plan {
  key              String        @id
  name             String
  // List price PER SEAT PER MONTH. The amount a tenant pays is
  // `pricePerSeat * seats`, computed at display time (never stored). A deal
  // snapshots this onto the Subscription as its starting negotiated rate.
  listPricePerSeat Decimal       @default(0) @map("list_price_per_seat") @db.Decimal(12, 2)
  currency         String        @default("INR")
  // Default seat count pre-filled in the onboarding wizard — NOT a bundled
  // allotment. The operator sets the real seat count per tenant.
  seatsIncluded    Int           @map("seats_included")
  enabledModules   String[]      @default([]) @map("enabled_modules")
  features         Json          @default("{}")
  isolationTier    IsolationTier @default(POOLED) @map("isolation_tier")
  sortOrder        Int           @default(0) @map("sort_order")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@map("plans")
  @@schema("platform")
}

model Tenant {
  id            String       @id @default(uuid()) @db.Uuid
  name          String
  subdomain     String       @unique
  status        TenantStatus @default(TRIAL)
  // Denormalized headcount, refreshed by PlatformAdminService via the
  // low-privilege hrms_app connection (never via the platform role, which
  // has no grants on tenant tables) — see platform-admin.service.ts.
  employeeCount Int          @default(0) @map("employee_count")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  subscription Subscription?
  breakGlassGrants BreakGlassGrant[]

  @@map("tenants")
  @@schema("platform")
}

model Subscription {
  id       String           @id @default(uuid()) @db.Uuid
  tenantId String           @unique @map("tenant_id") @db.Uuid
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @default(TRIAL)
  seats    Int              @default(50)
  renewsAt DateTime?        @map("renews_at")

  // NEGOTIATED per-seat rate for THIS tenant (every deal is bespoke).
  // Effective monthly = pricePerSeat * seats. Snapshotted at assign-time,
  // defaulting to the plan's list rate. A renewal KEEPS this rate (it's the
  // contract term) while re-snapshotting modules/features; an explicit plan
  // change resets it to the new plan's list price. Isolation tier is
  // snapshotted the same way. A later Plan catalog edit never touches these.
  pricePerSeat  Decimal?      @map("price_per_seat") @db.Decimal(12, 2)
  isolationTier IsolationTier @default(POOLED) @map("isolation_tier")

  // Plan entitlements — what this tenant is ALLOWED to use, derived from
  // `plan` at onboarding (see platform-admin/entitlements.ts) and re-derived
  // on plan change. This is the commercial boundary; it is NOT where a
  // tenant's HR rules live (those are public.tenant_settings et al.).
  //   enabledModules — e.g. ["CORE_HR","LEAVE","ATTENDANCE","PAYROLL"]
  //   features       — e.g. { "biometricIntegration": true, "customRoles": false }
  enabledModules String[] @default([]) @map("enabled_modules")
  features       Json     @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("subscriptions")
  @@schema("platform")
}

model PlatformAdminUser {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  firebaseUid String   @unique @map("firebase_uid")
  fullName    String   @map("full_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("platform_admin_users")
  @@schema("platform")
}

model PlatformAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorEmail String   @map("actor_email")
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("platform_audit_log")
  @@schema("platform")
}

// Time-boxed, logged, read-only support access to one tenant — the
// "break-glass" flow CLAUDE.md's multi-tenancy section calls for instead of
// a standing grant. This table is the auditable control-plane record
// (who/why/when/expiry/revoke) that platform-admin.service.ts's
// request/status/revoke endpoints manage. It does NOT itself widen the
// `hrms_platform` role's DB grants — actually elevating a read against one
// tenant's data for the grant's lifetime is a separate connection-pool
// escalation mechanism, deliberately not built yet (see docs/MODULE_SPECS.md
// module 02 "Known gaps").
model BreakGlassGrant {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedBy  String            @map("requested_by")
  reason       String
  status       BreakGlassStatus  @default(ACTIVE)
  accessCount  Int               @default(0) @map("access_count")
  grantedAt    DateTime          @default(now()) @map("granted_at")
  expiresAt    DateTime          @map("expires_at")
  revokedAt    DateTime?         @map("revoked_at")
  revokedBy    String?           @map("revoked_by")

  @@index([tenantId])
  @@index([status, expiresAt])
  @@map("break_glass_grants")
  @@schema("platform")
}

// ─────────────────────────────────────────────────────────────────────────
// TENANT SCHEMA (public) — every model here carries tenantId and is
// governed by an RLS policy. The `app` Postgres role used by the API for
// tenant requests does NOT have BYPASSRLS.
// ─────────────────────────────────────────────────────────────────────────

enum UserRole {
  COMPANY_ADMIN
  HR_MANAGER
  LINE_MANAGER
  EMPLOYEE
  AUDITOR

  @@schema("public")
}

// Outcome of a POST /api/auth/session attempt. Only outcomes the server
// actually observes are represented — BAD_CREDENTIALS happens entirely in
// the Firebase client SDK and never reaches us (see
// docs/modules/01_IDENTITY_AND_ACCESS.md §9). TENANT_SUSPENDED is rejected
// pre-auth in TenantResolutionMiddleware and is intentionally not written
// per-request; the operator's suspend/resume action is logged once in
// platform.platform_audit_log instead.
enum LoginOutcome {
  SUCCESS
  USER_INACTIVE
  CLAIM_MISMATCH
  TOKEN_EXPIRED

  @@schema("public")
}

// Replaces the old EmploymentStatus (ACTIVE/ON_LEAVE/SUSPENDED/RESIGNED/
// TERMINATED) with the SRS-target lifecycle state machine — see
// docs/modules/03_EMPLOYEE_MASTER.md §4.4 for the allowed-transition graph.
// ON_LEAVE is no longer a lifecycle state: day-to-day leave is tracked on
// AttendanceRecord/LeaveRequest, not here.
enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  CONSULTANT

  @@schema("public")
}

enum TaxRegime {
  OLD
  NEW

  @@schema("public")
}

enum BankAccountType {
  SAVINGS
  CURRENT

  @@schema("public")
}

enum DocumentCategory {
  OFFER_LETTER
  ID_PROOF
  ADDRESS_PROOF
  EDUCATION
  EXPERIENCE
  OTHER

  @@schema("public")
}

enum DocumentOwnerType {
  EMPLOYEE_PROFILE
  LEAVE_REQUEST
  REGULARIZATION

  @@schema("public")
}

enum DocumentScanStatus {
  PENDING_SCAN
  CLEAN
  INFECTED
  SCAN_FAILED

  @@schema("public")
}

enum EmployeeLifecycleState {
  PRE_JOINING
  PROBATION
  CONFIRMED
  NOTICE_PERIOD
  SUSPENDED
  SEPARATED

  @@schema("public")
}

enum LeaveRequestStatus {
  PENDING_L1
  PENDING_L2
  APPROVED
  REJECTED
  CANCELLED

  @@schema("public")
}

enum AttendanceStatus {
  PRESENT
  LATE
  ON_LEAVE
  WEEKLY_OFF
  HOLIDAY
  ABSENT
  PENDING_REGULARIZATION

  @@schema("public")
}

enum AttendanceSource {
  WEB
  // The following are capture channels the punch pipeline is designed to
  // accept. Only WEB has a live write path today; the rest are wired per
  // client as needed (BIOMETRIC device integration stays on CLAUDE.md's
  // deferred list until a specific customer needs it — gate it behind the
  // subscription's `biometricIntegration` feature flag when you do).
  BIOMETRIC
  GPS
  IMPORT
  MANUAL

  @@schema("public")
}

enum PunchDirection {
  IN
  OUT

  @@schema("public")
}

enum ShiftType {
  FIXED
  FLEXI
  ROTATIONAL

  @@schema("public")
}

enum TenantSetupWizardStatus {
  PENDING
  IN_PROGRESS
  DISMISSED
  COMPLETED

  @@schema("public")
}

enum AttendanceMode {
  // Employees clock themselves in/out via the web app (startup default).
  SELF_SERVICE
  // Attendance comes from an assigned roster + device/import punches; the
  // self-service clock-in button is hidden.
  ROSTER
  // No attendance tracking — leave-only (trust-based). Nightly finalization
  // still marks holidays/weekly-offs/approved leave for payroll.
  OFF

  @@schema("public")
}

enum RegularizationUnactionedBehavior {
  // At payroll cut-off, regularization requests a manager never actioned
  // are auto-approved (lenient) ...
  AUTO_APPROVE
  // ... or auto-rejected (strict — the day stands as-is, LOP if absent).
  AUTO_REJECT

  @@schema("public")
}

enum RegularizationReasonType {
  MISSED_PUNCH_IN
  MISSED_PUNCH_OUT
  WRONG_PUNCH_TIME
  FORGOT_TO_CLOCK_IN
  FORGOT_TO_CLOCK_OUT
  ON_DUTY_FIELD_WORK
  OTHER

  @@schema("public")
}

enum RegularizationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@schema("public")
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  email       String
  firebaseUid String   @unique @map("firebase_uid")
  role        UserRole
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employee Employee?

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
  @@schema("public")
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  code      String?
  // No FK to Employee — headEmployeeId is a plain reference, not a
  // relation, so deleting the head employee never cascades into the
  // department row (module 03 §4.3).
  headEmployeeId String? @map("head_employee_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employees Employee[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("departments")
  @@schema("public")
}

model Employee {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  userId   String? @unique @map("user_id") @db.Uuid
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  employeeCode  String    @map("employee_code")
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  personalEmail String?   @map("personal_email")
  phone         String?
  dateOfBirth   DateTime? @map("date_of_birth")
  gender        String?

  // Identity & personal — module 03 §4.2.
  maritalStatus String? @map("marital_status")
  bloodGroup    String? @map("blood_group")
  nationality   String?
  // Object-storage key for the uploaded avatar (private bucket, like
  // documents) — resolved to a short-lived presigned URL on read
  // (`photoUrl` in the API response), never stored as a raw/public URL.
  photoKey      String? @map("photo_key")

  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  designation      String?
  employmentType   EmploymentType?  @map("employment_type")
  workLocation     String?          @map("work_location")
  dateOfJoining    DateTime?        @map("date_of_joining")

  // Lifecycle state machine (module 03 §4.4). New employees start in
  // PROBATION (the common case: HR is adding someone who has already
  // joined) — pick PRE_JOINING explicitly for a not-yet-started hire.
  lifecycleState   EmployeeLifecycleState @default(PROBATION) @map("lifecycle_state")
  // Set when the relevant transition requires it (module 03 §4.4); null
  // otherwise. Each is written only by the matching PATCH .../lifecycle call.
  probationEndDate DateTime?              @map("probation_end_date")
  confirmationDate DateTime?              @map("confirmation_date")
  noticeStartDate  DateTime?              @map("notice_start_date")
  lastWorkingDate  DateTime?              @map("last_working_date")

  reportingManagerId String?    @map("reporting_manager_id") @db.Uuid
  reportingManager   Employee?  @relation("ManagerReports", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  directReports      Employee[] @relation("ManagerReports")

  // Optional per-employee shift override. NULL = the tenant's default shift
  // (the one `Shift.isDefault = true`). Hospital rota staff get a
  // ROTATIONAL shift here; desk staff inherit the default.
  shiftId String? @map("shift_id") @db.Uuid
  shift   Shift?  @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  // Compensation-adjacent — headline reference figures only; the salary
  // *structure* lives in Payroll (module 07), not here.
  ctcAnnual  Decimal? @map("ctc_annual") @db.Decimal(14, 2)
  payGrade   String?  @map("pay_grade")
  costCenter String?  @map("cost_center")

  // Statutory (India) — module 03 §4.2/INV-2/INV-3. `pan`/bank account are
  // application-layer encrypted (FieldEncryptionService, CLAUDE.md's KMS
  // non-negotiable); only the masked form and the ciphertext are stored —
  // plaintext never lands in a column. Aadhaar: last 4 digits only, ever.
  panCiphertext String? @map("pan_ciphertext")
  panMasked     String? @map("pan_masked")
  aadhaarLast4  String? @map("aadhaar_last4")
  uan           String?
  pfNumber      String? @map("pf_number")
  esicNumber    String? @map("esic_number")
  taxRegime     TaxRegime? @map("tax_regime")

  // Bank (disbursement) — bank account number is KMS-encrypted like PAN.
  bankAccountHolderName String?          @map("bank_account_holder_name")
  bankAccountCiphertext String?          @map("bank_account_ciphertext")
  bankAccountMasked     String?          @map("bank_account_masked")
  bankIfsc              String?          @map("bank_ifsc")
  bankName              String?          @map("bank_name")
  bankBranch            String?          @map("bank_branch")
  bankAccountType       BankAccountType? @map("bank_account_type")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  leaveBalances            LeaveBalance[]
  leaveRequestsAsApplicant LeaveRequest[]          @relation("Applicant")
  leaveLedgerEntries       LeaveLedgerEntry[]
  leaveApprovalsGiven      LeaveApproval[]         @relation("LeaveApprover")
  documents                Document[]
  attendanceRecords        AttendanceRecord[]
  regularizationRequests   RegularizationRequest[]
  punches                  Punch[]
  emergencyContacts        EmergencyContact[]

  @@unique([tenantId, employeeCode])
  @@index([tenantId])
  @@index([tenantId, reportingManagerId])
  @@map("employees")
  @@schema("public")
}

// Module 09 — every user-uploaded file (docs/modules/09_DOCUMENTS.md).
// `employeeId` is the *subject* employee and drives visibility (RULE-4);
// `ownerType`/`ownerId` say which record it's attached to (ownerId is NULL
// for EMPLOYEE_PROFILE). Never downloadable until `scanStatus = CLEAN`;
// delete is soft (`deletedAt`) — hrms_app has no DELETE grant here.
model Document {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  ownerType DocumentOwnerType @default(EMPLOYEE_PROFILE) @map("owner_type")
  ownerId   String?           @map("owner_id") @db.Uuid

  label      String
  category   DocumentCategory @default(OTHER)
  storageKey String           @map("storage_key")
  mimeType   String           @map("mime_type")
  sizeBytes  Int              @map("size_bytes")

  scanStatus    DocumentScanStatus @default(PENDING_SCAN) @map("scan_status")
  scannedAt     DateTime?          @map("scanned_at")
  scanSignature String?            @map("scan_signature")

  uploadedById   String?  @map("uploaded_by_id") @db.Uuid
  uploadedByName String?  @map("uploaded_by_name")
  uploadedAt     DateTime @default(now()) @map("uploaded_at")

  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, ownerType, ownerId])
  @@map("documents")
  @@schema("public")
}

// Module 03 §4.2 — 0..n per employee, exactly one `isPrimary` (RULE-5,
// enforced in EmployeesService: setting a new primary unsets the old one in
// the same transaction — no partial unique index, same pattern as
// LeaveType.isCompOff's app-level "at most one" invariant).
model EmergencyContact {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  name         String
  relationship String
  phone        String
  altPhone     String? @map("alt_phone")
  address      String?
  isPrimary    Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("emergency_contacts")
  @@schema("public")
}

model LeaveType {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  name             String
  // Short label for dense UI (e.g. "CL", "SL") — user-set, unique per tenant.
  code             String
  // A CSS color value for calendar chips / dots.
  colorToken       String           @default("#2b5a8c") @map("color_token")
  annualQuota      Decimal          @map("annual_quota") @db.Decimal(6, 2)
  carryForwardCap  Decimal          @default(0) @map("carry_forward_cap") @db.Decimal(6, 2)
  requiresApproval Boolean          @default(true) @map("requires_approval")
  // Minimum calendar-days notice; enforced by LeaveService.apply().
  minNoticeDays    Int              @default(0) @map("min_notice_days")
  // Soft-delete: hides the type from the apply dropdown without losing history.
  active           Boolean          @default(true)
  // Periodic credit schedule the accrual job follows; ANNUAL types are still
  // seeded manually via the initialize-year endpoint.
  accrualFrequency AccrualFrequency  @default(ANNUAL) @map("accrual_frequency")
  // Who may apply for this type; enforced by LeaveService.apply().
  genderRestriction GenderRestriction @default(ANY) @map("gender_restriction")
  // Whether this leave type is paid; informational only, no payroll linkage yet.
  paid              Boolean           @default(true)
  // Marks the tenant's designated comp-off type — LeaveService.creditCompOff()
  // credits into whichever LeaveType has this set (at most one expected per
  // tenant; not DB-enforced). No-op if a tenant hasn't configured one.
  isCompOff         Boolean           @default(false) @map("is_comp_off")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  balances LeaveBalance[]
  requests LeaveRequest[]
  ledgerEntries LeaveLedgerEntry[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("leave_types")
  @@schema("public")
}

enum GenderRestriction {
  ANY
  MALE
  FEMALE

  @@schema("public")
}

enum AccrualFrequency {
  ANNUAL
  MONTHLY
  QUARTERLY

  @@schema("public")
}

model LeaveBalance {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  employeeId  String    @map("employee_id") @db.Uuid
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String    @map("leave_type_id") @db.Uuid
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  year      Int
  accrued   Decimal  @default(0) @db.Decimal(6, 2)
  used      Decimal  @default(0) @db.Decimal(6, 2)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, employeeId, leaveTypeId, year])
  @@index([tenantId])
  @@map("leave_balances")
  @@schema("public")
}

model LeaveRequest {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation("Applicant", fields: [employeeId], references: [id], onDelete: Cascade)

  leaveTypeId String    @map("leave_type_id") @db.Uuid
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  days      Decimal  @db.Decimal(6, 2)
  halfDay   Boolean  @default(false) @map("half_day")
  isLop     Boolean  @default(false) @map("is_lop")
  reason    String?

  status LeaveRequestStatus @default(PENDING_L1)

  l1ApproverId String?   @map("l1_approver_id") @db.Uuid
  l1DecidedAt  DateTime? @map("l1_decided_at")
  l2ApproverId String?   @map("l2_approver_id") @db.Uuid
  l2DecidedAt  DateTime? @map("l2_decided_at")

  // Supporting document (e.g. a medical certificate) lives in `documents`
  // with ownerType = LEAVE_REQUEST, ownerId = this id (module 09).

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  approvals LeaveApproval[]

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("leave_requests")
  @@schema("public")
}

/// Append-only decision/escalation history — backs the request detail timeline.
model LeaveApproval {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  leaveRequestId String       @map("leave_request_id") @db.Uuid
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  level Int
  // Null approverId marks a system-generated escalation entry.
  approverId String?   @map("approver_id") @db.Uuid
  approver   Employee? @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)
  decision   LeaveApprovalDecision
  decidedAt  DateTime             @default(now()) @map("decided_at")
  comment    String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([tenantId, leaveRequestId])
  @@map("leave_approvals")
  @@schema("public")
}

enum LeaveApprovalDecision {
  APPROVED
  REJECTED
  ESCALATED

  @@schema("public")
}

/// Append-only balance movement audit trail: accrual, carry-forward, request lifecycle, HR adjustment.
model LeaveLedgerEntry {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveTypeId String    @map("leave_type_id") @db.Uuid
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  occurredAt   DateTime          @default(now()) @map("occurred_at")
  delta        Decimal           @db.Decimal(6, 2)
  balanceAfter Decimal           @map("balance_after") @db.Decimal(6, 2)
  source       LeaveLedgerSource
  note         String?
  actorUserId  String?           @map("actor_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([tenantId, employeeId, leaveTypeId])
  @@map("leave_ledger_entries")
  @@schema("public")
}

enum LeaveLedgerSource {
  ACCRUAL
  CARRY_FORWARD
  REQUEST_APPROVED
  REQUEST_CANCELLED
  HR_ADJUSTMENT
  COMP_OFF_CREDIT

  @@schema("public")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id")
  metadata    Json?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("audit_log")
  @@schema("public")
}

// Append-only record of every server-observed sign-in attempt (functional
// expectation #8, module 01). hrms_app holds SELECT + INSERT on this table
// only — no UPDATE/DELETE grant — and it is RLS-scoped like every other
// tenant table. Written by AuthService.session() on each outcome branch;
// read by GET /api/access/audit?feed=login. 2-year retention (enforced by a
// later scheduled purge, not yet built).
model LoginAuditEntry {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  email     String
  userId    String?      @map("user_id") @db.Uuid
  outcome   LoginOutcome
  ipAddress String?      @map("ip_address")
  userAgent String?      @map("user_agent")
  at        DateTime     @default(now())

  @@index([tenantId])
  @@index([tenantId, at])
  @@index([tenantId, userId, outcome])
  @@map("login_audit_entries")
  @@schema("public")
}

model AttendanceRecord {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date       DateTime         @db.Date
  checkInAt  DateTime?        @map("check_in_at")
  checkOutAt DateTime?        @map("check_out_at")
  status     AttendanceStatus @default(ABSENT)
  source     AttendanceSource @default(WEB)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  breaks                 AttendanceBreak[]
  regularizationRequests RegularizationRequest[]

  @@unique([tenantId, employeeId, date])
  @@index([tenantId])
  @@map("attendance_records")
  @@schema("public")
}

model AttendanceBreak {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  attendanceRecordId String           @map("attendance_record_id") @db.Uuid
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)

  startAt   DateTime  @map("start_at")
  endAt     DateTime? @map("end_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([attendanceRecordId])
  @@map("attendance_breaks")
  @@schema("public")
}

model RegularizationRequest {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  attendanceRecordId String?           @map("attendance_record_id") @db.Uuid
  attendanceRecord   AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id], onDelete: SetNull)

  targetDate          DateTime                 @map("target_date") @db.Date
  reasonType          RegularizationReasonType @map("reason_type")
  requestedCheckInAt  DateTime?                @map("requested_check_in_at")
  requestedCheckOutAt DateTime?                @map("requested_check_out_at")
  note                String?

  status     RegularizationStatus @default(PENDING)
  approverId String?              @map("approver_id") @db.Uuid
  decidedAt  DateTime?            @map("decided_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("regularization_requests")
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────
// TENANT CONFIGURATION — how each tenant's HR rules work. Company Admin
// owns these (via in-app Settings), NOT the platform operator. Seeded with
// working defaults on tenant creation (see platform-admin.service.ts) so a
// new tenant functions before anyone opens Settings. All RLS-scoped like
// every other public table. See docs/TENANT_CONFIGURATION.md.
// ─────────────────────────────────────────────────────────────────────────

model TenantSettings {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid

  // IANA zone; wall-clock shift times and "today" boundaries resolve against this.
  timezone            String @default("Asia/Kolkata")
  // Days of week that are weekly-offs. 0 = Sunday … 6 = Saturday.
  weeklyOffDays       Int[]  @default([0, 6]) @map("weekly_off_days")
  // Day of month the payroll period locks — the only hard deadline the
  // attendance/regularization auto-resolve flow hangs on.
  payrollCutoffDay    Int    @default(25) @map("payroll_cutoff_day")
  // Leave approval chain depth (1 or 2 for V1).
  leaveApprovalLevels Int    @default(2) @map("leave_approval_levels")
  // Days a leave request may sit undecided at a level before the escalation
  // job flags it (see apps/api/src/leave/leave-escalation.processor.ts).
  leaveEscalationDays Int    @default(3) @map("leave_escalation_days")
  // Whether an employee may submit a request that will be Loss of Pay.
  // Enforced by LeaveService.apply().
  allowLopRequests    Boolean @default(true) @map("allow_lop_requests")
  // Financial-year start month (1-12; India default April). Used by
  // resolveLeaveYear() (apps/api/src/leave/leave-year.util.ts) to shift the
  // balance-year boundary for apply()/getBalances()/teamBalances()/the accrual job.
  fyStartMonth        Int    @default(4) @map("fy_start_month")

  // First-run setup wizard (docs/TENANT_CONFIGURATION.md "Onboarding flow"
  // step 3) — skippable, resumable. `setupWizardStep` is the 0-indexed step
  // to resume at; meaningless once status is DISMISSED/COMPLETED.
  setupWizardStatus TenantSetupWizardStatus @default(PENDING) @map("setup_wizard_status")
  setupWizardStep   Int                     @default(0) @map("setup_wizard_step")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("tenant_settings")
  @@schema("public")
}

model Shift {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name            String
  type            ShiftType @default(FIXED)
  // Wall-clock "HH:MM" in the tenant timezone.
  startTime       String    @map("start_time")
  endTime         String    @map("end_time")
  graceMinutes    Int       @default(15) @map("grace_minutes")
  minHoursFullDay Decimal   @default(8) @map("min_hours_full_day") @db.Decimal(4, 2)
  minHoursHalfDay Decimal   @default(4) @map("min_hours_half_day") @db.Decimal(4, 2)
  // For FLEXI shifts: the window that must be covered regardless of start.
  coreStartTime   String?   @map("core_start_time")
  coreEndTime     String?   @map("core_end_time")
  // Exactly one shift per tenant should have this set; it's the fallback
  // for employees with no explicit `Employee.shiftId`.
  isDefault       Boolean   @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employees Employee[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("shifts")
  @@schema("public")
}

model Holiday {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  date       DateTime @db.Date
  name       String
  // Optional/restricted holiday — employee may choose to avail it or not.
  isOptional Boolean  @default(false) @map("is_optional")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, date, name])
  @@index([tenantId])
  @@index([tenantId, date])
  @@map("holidays")
  @@schema("public")
}

model AttendanceSettings {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid

  mode           AttendanceMode     @default(SELF_SERVICE)
  // Which capture channels are accepted for this tenant. The frontend hides
  // the web clock-in button when WEB is absent.
  captureMethods AttendanceSource[] @default([WEB]) @map("capture_methods")

  // Regularization guardrails.
  regularizationWindowDays Int                              @default(7) @map("regularization_window_days")
  regularizationMonthlyCap Int                              @default(3) @map("regularization_monthly_cap")
  unactionedBehavior       RegularizationUnactionedBehavior @default(AUTO_APPROVE) @map("unactioned_behavior")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("attendance_settings")
  @@schema("public")
}

// Raw capture events. Source of truth for attendance — a web clock-in, a
// biometric device webhook, and a CSV import all land here identically, and
// the (future) nightly finalization job rolls them up into
// AttendanceRecord. `AttendanceRecord.checkInAt/checkOutAt` remain as a
// denormalized convenience (first IN / last OUT of the day).
model Punch {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  at        DateTime
  direction PunchDirection
  source    AttendanceSource @default(WEB)
  // Set for device/import sources: which device, and the provider's own row id.
  deviceId  String?          @map("device_id")
  rawRef    String?          @map("raw_ref")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([tenantId, employeeId, at])
  @@map("punches")
  @@schema("public")
}
