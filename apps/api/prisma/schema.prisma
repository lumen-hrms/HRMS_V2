// HRMS Platform — Prisma schema
//
// Multi-tenancy model: SHARED database, SHARED schema (public), every
// tenant-owned table carries a `tenantId` column and is protected by a
// PostgreSQL Row-Level Security policy keyed off the session variable
// `app.current_tenant_id` (set per-request by TenantGuard/PrismaService).
//
// Platform-operator data (the founder's own SaaS-admin console) lives in a
// physically separate Postgres schema (`platform`) with its own DB role
// that has zero grants on the tenant tables below. See:
//   prisma/migrations/*_rls/migration.sql
//   prisma/migrations/*_platform_role_isolation/migration.sql

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "platform"]
}

// ─────────────────────────────────────────────────────────────────────────
// PLATFORM SCHEMA — owned by the SaaS operator, never joined against
// tenant business tables. The `platform` Postgres role can read/write here
// and here only.
// ─────────────────────────────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  // In its trial window (Subscription.trialEndsAt). The subscription's plan
  // is the chosen sold plan from day one — TRIAL is a state, not a plan.
  TRIAL
  // Trial ended without an operator converting it: the tenant can sign in
  // and read its data, but every write is refused (TenantResolutionMiddleware).
  READ_ONLY

  @@schema("platform")
}

enum SubscriptionPlan {
  TRIAL
  STARTER
  GROWTH
  ENTERPRISE

  @@schema("platform")
}

enum IsolationTier {
  POOLED
  DEDICATED

  @@schema("platform")
}

enum BreakGlassStatus {
  ACTIVE
  EXPIRED
  REVOKED

  @@schema("platform")
}

// The operator-editable plan catalog (Platform Admin → Plans). `key` matches
// the `SubscriptionPlan` values a tenant can be onboarded onto
// (STARTER/GROWTH/ENTERPRISE — TRIAL is a status, not a sold plan). Seeded
// from platform-admin/entitlements.ts (which stays as the code-side default
// + fallback). Editing a Plan row NEVER mutates a live Subscription — those
// carry a snapshot; new tenants and renewals pick up the current Plan.
model Plan {
  key              String        @id
  name             String
  // List price PER SEAT PER MONTH. The amount a tenant pays is
  // `pricePerSeat * seats`, computed at display time (never stored). A deal
  // snapshots this onto the Subscription as its starting negotiated rate.
  listPricePerSeat Decimal       @default(0) @map("list_price_per_seat") @db.Decimal(12, 2)
  currency         String        @default("INR")
  // Default seat count pre-filled in the onboarding wizard — NOT a bundled
  // allotment. The operator sets the real seat count per tenant.
  seatsIncluded    Int           @map("seats_included")
  enabledModules   String[]      @default([]) @map("enabled_modules")
  features         Json          @default("{}")
  isolationTier    IsolationTier @default(POOLED) @map("isolation_tier")
  sortOrder        Int           @default(0) @map("sort_order")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@map("plans")
  @@schema("platform")
}

model Tenant {
  id            String       @id @default(uuid()) @db.Uuid
  name          String
  subdomain     String       @unique
  status        TenantStatus @default(TRIAL)
  // Denormalized headcount, refreshed by PlatformAdminService via the
  // low-privilege hrms_app connection (never via the platform role, which
  // has no grants on tenant tables) — see platform-admin.service.ts.
  employeeCount Int          @default(0) @map("employee_count")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  subscription Subscription?
  breakGlassGrants BreakGlassGrant[]

  @@map("tenants")
  @@schema("platform")
}

model Subscription {
  id       String           @id @default(uuid()) @db.Uuid
  tenantId String           @unique @map("tenant_id") @db.Uuid
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @default(TRIAL)
  seats    Int              @default(50)
  renewsAt DateTime?        @map("renews_at")
  // End of the trial window set by the operator at onboarding. Null once the
  // tenant is converted to a paid plan (or for tenants that never had a trial).
  trialEndsAt DateTime?     @map("trial_ends_at")
  // Razorpay subscription driving this tenant's monthly charge (module 14).
  // Null for tenants billed offline (operator "Convert to paid").
  razorpaySubscriptionId String?  @unique @map("razorpay_subscription_id")
  // Set when a charge fails; the daily job moves the tenant READ_ONLY once it
  // passes. Cleared by the next successful charge.
  graceEndsAt DateTime?     @map("grace_ends_at")

  // NEGOTIATED per-seat rate for THIS tenant (every deal is bespoke).
  // Effective monthly = pricePerSeat * seats. Snapshotted at assign-time,
  // defaulting to the plan's list rate. A renewal KEEPS this rate (it's the
  // contract term) while re-snapshotting modules/features; an explicit plan
  // change resets it to the new plan's list price. Isolation tier is
  // snapshotted the same way. A later Plan catalog edit never touches these.
  pricePerSeat  Decimal?      @map("price_per_seat") @db.Decimal(12, 2)
  isolationTier IsolationTier @default(POOLED) @map("isolation_tier")

  // Plan entitlements — what this tenant is ALLOWED to use, derived from
  // `plan` at onboarding (see platform-admin/entitlements.ts) and re-derived
  // on plan change. This is the commercial boundary; it is NOT where a
  // tenant's HR rules live (those are public.tenant_settings et al.).
  //   enabledModules — e.g. ["CORE_HR","LEAVE","ATTENDANCE","PAYROLL"]
  //   features       — e.g. { "biometricIntegration": true, "customRoles": false }
  enabledModules String[] @default([]) @map("enabled_modules")
  features       Json     @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("subscriptions")
  @@schema("platform")
}

model PlatformAdminUser {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  firebaseUid String   @unique @map("firebase_uid")
  fullName    String   @map("full_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("platform_admin_users")
  @@schema("platform")
}

model PlatformAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorEmail String   @map("actor_email")
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("platform_audit_log")
  @@schema("platform")
}

// The public "Contact us" form on the landing page (pre-tenant, no auth) —
// captured here rather than relying on the notification email alone
// arriving, so a lead survives even if SES is unreachable at submit time.
// `hrms_platform` has SELECT/INSERT only (no UPDATE/DELETE) — same
// append-only instinct as the audit tables, since a lead record shouldn't
// be edited after the fact.
model ContactSubmission {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String
  company   String?
  phone     String?
  message   String
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("contact_submissions")
  @@schema("platform")
}

// Singleton row (id is always the literal string "singleton") for
// operator-editable, non-tenant platform configuration. Today this is just
// who gets emailed on a new ContactSubmission; more platform-wide settings
// can land as columns here later rather than one-table-per-setting.
model PlatformSettings {
  id                  String   @id @default("singleton")
  contactNotifyEmails String[] @default([]) @map("contact_notify_emails")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
  @@schema("platform")
}

// Time-boxed, logged, read-only support access to one tenant — the
// "break-glass" flow CLAUDE.md's multi-tenancy section calls for instead of
// a standing grant. This table is the auditable control-plane record
// (who/why/when/expiry/revoke) that platform-admin.service.ts's
// request/status/revoke endpoints manage. It does NOT itself widen the
// `hrms_platform` role's DB grants — actually elevating a read against one
// tenant's data for the grant's lifetime is a separate connection-pool
// escalation mechanism, deliberately not built yet (see docs/MODULE_SPECS.md
// module 02 "Known gaps").
model BreakGlassGrant {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedBy  String            @map("requested_by")
  reason       String
  status       BreakGlassStatus  @default(ACTIVE)
  accessCount  Int               @default(0) @map("access_count")
  grantedAt    DateTime          @default(now()) @map("granted_at")
  expiresAt    DateTime          @map("expires_at")
  revokedAt    DateTime?         @map("revoked_at")
  revokedBy    String?           @map("revoked_by")

  @@index([tenantId])
  @@index([status, expiresAt])
  @@map("break_glass_grants")
  @@schema("platform")
}

// ─────────────────────────────────────────────────────────────────────────
// TENANT SCHEMA (public) — every model here carries tenantId and is
// governed by an RLS policy. The `app` Postgres role used by the API for
// tenant requests does NOT have BYPASSRLS.
// ─────────────────────────────────────────────────────────────────────────

enum UserRole {
  COMPANY_ADMIN
  HR_MANAGER
  LINE_MANAGER
  EMPLOYEE
  AUDITOR

  @@schema("public")
}

// Outcome of a POST /api/auth/session attempt. Only outcomes the server
// actually observes are represented — BAD_CREDENTIALS happens entirely in
// the Firebase client SDK and never reaches us (see
// docs/modules/01_IDENTITY_AND_ACCESS.md §9). TENANT_SUSPENDED is rejected
// pre-auth in TenantResolutionMiddleware and is intentionally not written
// per-request; the operator's suspend/resume action is logged once in
// platform.platform_audit_log instead.
enum LoginOutcome {
  SUCCESS
  USER_INACTIVE
  CLAIM_MISMATCH
  TOKEN_EXPIRED

  @@schema("public")
}

// Replaces the old EmploymentStatus (ACTIVE/ON_LEAVE/SUSPENDED/RESIGNED/
// TERMINATED) with the SRS-target lifecycle state machine — see
// docs/modules/03_EMPLOYEE_MASTER.md §4.4 for the allowed-transition graph.
// ON_LEAVE is no longer a lifecycle state: day-to-day leave is tracked on
// AttendanceRecord/LeaveRequest, not here.
enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  CONSULTANT

  @@schema("public")
}

enum TaxRegime {
  OLD
  NEW

  @@schema("public")
}

enum BankAccountType {
  SAVINGS
  CURRENT

  @@schema("public")
}

enum DocumentCategory {
  OFFER_LETTER
  ID_PROOF
  ADDRESS_PROOF
  EDUCATION
  EXPERIENCE
  OTHER

  @@schema("public")
}

enum DocumentOwnerType {
  EMPLOYEE_PROFILE
  LEAVE_REQUEST
  REGULARIZATION

  @@schema("public")
}

enum DocumentScanStatus {
  PENDING_SCAN
  CLEAN
  INFECTED
  SCAN_FAILED

  @@schema("public")
}

enum NotificationTemplate {
  LEAVE_PENDING_APPROVAL
  LEAVE_DECIDED
  LEAVE_ESCALATED
  LEAVE_CANCELLED
  REGULARIZATION_PENDING_APPROVAL
  REGULARIZATION_DECIDED
  DOCUMENT_BLOCKED
  PAYROLL_RUN_STATUS_CHANGED
  OVERTIME_CLAIM_PENDING_APPROVAL
  OVERTIME_CLAIM_DECIDED
  PAYSLIP_READY

  @@schema("public")
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED

  @@schema("public")
}

enum SeparationReason {
  VOLUNTARY
  INVOLUNTARY
  OTHER

  @@schema("public")
}

enum EmployeeLifecycleState {
  PRE_JOINING
  PROBATION
  CONFIRMED
  NOTICE_PERIOD
  SUSPENDED
  SEPARATED

  @@schema("public")
}

enum LeaveRequestStatus {
  PENDING_L1
  PENDING_L2
  APPROVED
  REJECTED
  CANCELLED

  @@schema("public")
}

enum AttendanceStatus {
  PRESENT
  LATE
  ON_LEAVE
  WEEKLY_OFF
  HOLIDAY
  ABSENT
  PENDING_REGULARIZATION

  @@schema("public")
}

enum AttendanceSource {
  WEB
  // The following are capture channels the punch pipeline is designed to
  // accept. Only WEB has a live write path today; the rest are wired per
  // client as needed (BIOMETRIC device integration stays on CLAUDE.md's
  // deferred list until a specific customer needs it — gate it behind the
  // subscription's `biometricIntegration` feature flag when you do).
  BIOMETRIC
  GPS
  IMPORT
  MANUAL

  @@schema("public")
}

enum PunchDirection {
  IN
  OUT

  @@schema("public")
}

enum ShiftType {
  FIXED
  FLEXI
  ROTATIONAL

  @@schema("public")
}

enum TenantSetupWizardStatus {
  PENDING
  IN_PROGRESS
  DISMISSED
  COMPLETED

  @@schema("public")
}

enum AttendanceMode {
  // Employees clock themselves in/out via the web app (startup default).
  SELF_SERVICE
  // Attendance comes from an assigned roster + device/import punches; the
  // self-service clock-in button is hidden.
  ROSTER
  // No attendance tracking — leave-only (trust-based). Nightly finalization
  // still marks holidays/weekly-offs/approved leave for payroll.
  OFF

  @@schema("public")
}

enum RegularizationUnactionedBehavior {
  // At payroll cut-off, regularization requests a manager never actioned
  // are auto-approved (lenient) ...
  AUTO_APPROVE
  // ... or auto-rejected (strict — the day stands as-is, LOP if absent).
  AUTO_REJECT

  @@schema("public")
}

enum RegularizationReasonType {
  MISSED_PUNCH_IN
  MISSED_PUNCH_OUT
  WRONG_PUNCH_TIME
  FORGOT_TO_CLOCK_IN
  FORGOT_TO_CLOCK_OUT
  ON_DUTY_FIELD_WORK
  OTHER

  @@schema("public")
}

enum RegularizationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@schema("public")
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  email       String
  firebaseUid String   @unique @map("firebase_uid")
  role        UserRole
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employee Employee?

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
  @@schema("public")
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  code      String?
  // No FK to Employee — headEmployeeId is a plain reference, not a
  // relation, so deleting the head employee never cascades into the
  // department row (module 03 §4.3).
  headEmployeeId String? @map("head_employee_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employees Employee[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("departments")
  @@schema("public")
}

model Employee {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  userId   String? @unique @map("user_id") @db.Uuid
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  employeeCode  String    @map("employee_code")
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  personalEmail String?   @map("personal_email")
  phone         String?
  dateOfBirth   DateTime? @map("date_of_birth")
  gender        String?

  // Identity & personal — module 03 §4.2.
  maritalStatus String? @map("marital_status")
  bloodGroup    String? @map("blood_group")
  nationality   String?
  // Object-storage key for the uploaded avatar (private bucket, like
  // documents) — resolved to a short-lived presigned URL on read
  // (`photoUrl` in the API response), never stored as a raw/public URL.
  photoKey      String? @map("photo_key")

  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  designation      String?
  employmentType   EmploymentType?  @map("employment_type")
  workLocation     String?          @map("work_location")
  // Payroll (module 07): state of the office the employee is attached to;
  // drives Professional Tax slab selection. Required before the employee
  // can be included in a payroll run.
  workState        IndianState?     @map("work_state")
  // Payroll (module 07, decision 14): this employee's weekly off-days, if
  // they differ from the tenant's `TenantSettings.weeklyOffDays` (e.g.
  // rotational shift staff). Empty (the default) falls back to the tenant
  // default — Prisma can't express an optional list. A fixed set of
  // weekdays, not a rotating per-week schedule.
  weeklyOffDaysOverride Int[]       @default([]) @map("weekly_off_days_override")
  dateOfJoining    DateTime?        @map("date_of_joining")

  // Lifecycle state machine (module 03 §4.4). New employees start in
  // PROBATION (the common case: HR is adding someone who has already
  // joined) — pick PRE_JOINING explicitly for a not-yet-started hire.
  lifecycleState   EmployeeLifecycleState @default(PROBATION) @map("lifecycle_state")
  // Set when the relevant transition requires it (module 03 §4.4); null
  // otherwise. Each is written only by the matching PATCH .../lifecycle call.
  probationEndDate DateTime?              @map("probation_end_date")
  confirmationDate DateTime?              @map("confirmation_date")
  noticeStartDate  DateTime?              @map("notice_start_date")
  lastWorkingDate  DateTime?              @map("last_working_date")
  // Set by the SEPARATED transition (optional — null for legacy rows and for
  // callers that don't say). Feeds Reports' voluntary/involuntary attrition split.
  separationReason SeparationReason?      @map("separation_reason")

  reportingManagerId String?    @map("reporting_manager_id") @db.Uuid
  reportingManager   Employee?  @relation("ManagerReports", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  directReports      Employee[] @relation("ManagerReports")

  // Optional per-employee shift override. NULL = the tenant's default shift
  // (the one `Shift.isDefault = true`). Hospital rota staff get a
  // ROTATIONAL shift here; desk staff inherit the default.
  shiftId String? @map("shift_id") @db.Uuid
  shift   Shift?  @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  // Compensation-adjacent — headline reference figures only; the salary
  // *structure* lives in Payroll (module 07), not here.
  ctcAnnual  Decimal? @map("ctc_annual") @db.Decimal(14, 2)
  payGrade   String?  @map("pay_grade")
  costCenter String?  @map("cost_center")

  // Statutory (India) — module 03 §4.2/INV-2/INV-3. `pan`/bank account are
  // application-layer encrypted (FieldEncryptionService, CLAUDE.md's KMS
  // non-negotiable); only the masked form and the ciphertext are stored —
  // plaintext never lands in a column. Aadhaar: last 4 digits only, ever.
  panCiphertext String? @map("pan_ciphertext")
  panMasked     String? @map("pan_masked")
  aadhaarLast4  String? @map("aadhaar_last4")
  uan           String?
  pfNumber      String? @map("pf_number")
  esicNumber    String? @map("esic_number")
  taxRegime     TaxRegime? @map("tax_regime")

  // Bank (disbursement) — bank account number is KMS-encrypted like PAN.
  bankAccountHolderName String?          @map("bank_account_holder_name")
  bankAccountCiphertext String?          @map("bank_account_ciphertext")
  bankAccountMasked     String?          @map("bank_account_masked")
  bankIfsc              String?          @map("bank_ifsc")
  bankName              String?          @map("bank_name")
  bankBranch            String?          @map("bank_branch")
  bankAccountType       BankAccountType? @map("bank_account_type")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  leaveBalances            LeaveBalance[]
  leaveRequestsAsApplicant LeaveRequest[]          @relation("Applicant")
  leaveLedgerEntries       LeaveLedgerEntry[]
  leaveApprovalsGiven      LeaveApproval[]         @relation("LeaveApprover")
  documents                Document[]
  attendanceRecords        AttendanceRecord[]
  regularizationRequests   RegularizationRequest[]
  punches                  Punch[]
  emergencyContacts        EmergencyContact[]
  salaryStructures         SalaryStructure[]
  payrollLineItems         PayrollLineItem[]
  overtimeClaims           OvertimeClaim[]
  tdsRegimeChoices         TdsRegimeChoice[]
  salaryRevisions          SalaryRevision[]
  arrearsLineItems         ArrearsLineItem[]
  fullAndFinalSettlement   FullAndFinalSettlement?

  @@unique([tenantId, employeeCode])
  @@index([tenantId])
  @@index([tenantId, reportingManagerId])
  @@map("employees")
  @@schema("public")
}

// Module 09 — every user-uploaded file (docs/modules/09_DOCUMENTS.md).
// `employeeId` is the *subject* employee and drives visibility (RULE-4);
// `ownerType`/`ownerId` say which record it's attached to (ownerId is NULL
// for EMPLOYEE_PROFILE). Never downloadable until `scanStatus = CLEAN`;
// delete is soft (`deletedAt`) — hrms_app has no DELETE grant here.
model Document {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  ownerType DocumentOwnerType @default(EMPLOYEE_PROFILE) @map("owner_type")
  ownerId   String?           @map("owner_id") @db.Uuid

  label      String
  category   DocumentCategory @default(OTHER)
  storageKey String           @map("storage_key")
  mimeType   String           @map("mime_type")
  sizeBytes  Int              @map("size_bytes")

  scanStatus    DocumentScanStatus @default(PENDING_SCAN) @map("scan_status")
  scannedAt     DateTime?          @map("scanned_at")
  scanSignature String?            @map("scan_signature")

  uploadedById   String?  @map("uploaded_by_id") @db.Uuid
  uploadedByName String?  @map("uploaded_by_name")
  uploadedAt     DateTime @default(now()) @map("uploaded_at")

  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, ownerType, ownerId])
  @@map("documents")
  @@schema("public")
}

// Module 03 §4.2 — 0..n per employee, exactly one `isPrimary` (RULE-5,
// enforced in EmployeesService: setting a new primary unsets the old one in
// the same transaction — no partial unique index, same pattern as
// LeaveType.isCompOff's app-level "at most one" invariant).
model EmergencyContact {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  name         String
  relationship String
  phone        String
  altPhone     String? @map("alt_phone")
  address      String?
  isPrimary    Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("emergency_contacts")
  @@schema("public")
}

model LeaveType {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  name             String
  // Short label for dense UI (e.g. "CL", "SL") — user-set, unique per tenant.
  code             String
  // A CSS color value for calendar chips / dots.
  colorToken       String           @default("#2b5a8c") @map("color_token")
  annualQuota      Decimal          @map("annual_quota") @db.Decimal(6, 2)
  carryForwardCap  Decimal          @default(0) @map("carry_forward_cap") @db.Decimal(6, 2)
  requiresApproval Boolean          @default(true) @map("requires_approval")
  // Minimum calendar-days notice; enforced by LeaveService.apply().
  minNoticeDays    Int              @default(0) @map("min_notice_days")
  // Soft-delete: hides the type from the apply dropdown without losing history.
  active           Boolean          @default(true)
  // Periodic credit schedule the accrual job follows; ANNUAL types are still
  // seeded manually via the initialize-year endpoint.
  accrualFrequency AccrualFrequency  @default(ANNUAL) @map("accrual_frequency")
  // Who may apply for this type; enforced by LeaveService.apply().
  genderRestriction GenderRestriction @default(ANY) @map("gender_restriction")
  // Whether this leave type is paid; informational only, no payroll linkage yet.
