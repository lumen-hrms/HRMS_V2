  minHoursFullDay Decimal   @default(8) @map("min_hours_full_day") @db.Decimal(4, 2)
  minHoursHalfDay Decimal   @default(4) @map("min_hours_half_day") @db.Decimal(4, 2)
  // For FLEXI shifts: the window that must be covered regardless of start.
  coreStartTime   String?   @map("core_start_time")
  coreEndTime     String?   @map("core_end_time")
  // Exactly one shift per tenant should have this set; it's the fallback
  // for employees with no explicit `Employee.shiftId`.
  isDefault       Boolean   @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employees Employee[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("shifts")
  @@schema("public")
}

