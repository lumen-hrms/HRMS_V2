  captureMethods AttendanceSource[] @default([WEB]) @map("capture_methods")

  // Regularization guardrails.
  regularizationWindowDays Int                              @default(7) @map("regularization_window_days")
  regularizationMonthlyCap Int                              @default(3) @map("regularization_monthly_cap")
  unactionedBehavior       RegularizationUnactionedBehavior @default(AUTO_APPROVE) @map("unactioned_behavior")

