// Module 05 (Attendance) owns this workflow; Payroll (module 07 Phase 4,
// decision 6) only reads it via getApprovedOvertime()/getApprovedOvertimeBatch().
// One claim per employee per month: the employee claims that month's
// already-tracked overtime hours (Attendance.stats()' overtimeHours), then
// their manager and HR approve in sequence — same two-level shape as Leave.
// COMP_OFF claims convert to a Leave comp-off credit on HR approval and
// never reach Payroll; only fully-APPROVED CASH hours are paid.
model OvertimeClaim {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  employeeId String   @map("employee_id") @db.Uuid
