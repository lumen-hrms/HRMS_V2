# Firebase client config — from the Firebase console (Project settings ->
# General -> Your apps -> Web app). These are not secrets; they're safe to
# ship in the built bundle.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""

# Set to talk to the local Firebase Auth Emulator instead of a real
# project during development (leave unset in production).
VITE_FIREBASE_AUTH_EMULATOR_HOST="localhost:9099"
