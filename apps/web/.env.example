# Firebase web app config (Firebase console -> Project settings -> General ->
# Your apps -> Web app). These are NOT secrets — they ship in the built
# client bundle — but each developer / environment points at its own project.
# Copy to apps/web/.env and fill in. Must be the SAME project the API's
# FIREBASE_PROJECT_ID / FIREBASE_SERVICE_ACCOUNT_JSON point at.
#
# Only these three are read by apps/web/src/lib/firebase.ts.
VITE_FIREBASE_API_KEY="your-firebase-web-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"

# Leave Management runs against the real API by default (module 04). Set to
# "true" to fall back to apps/web/src/lib/leave's fixture/mock layer instead.
# VITE_LEAVE_MOCK=true
